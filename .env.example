# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables (Production), then redeploy.
# Never commit real values.

# ---- Website --------------------------------------------------------------
# true = full website and store; anything else = coming-soon page (admin always works at /admin)
VITE_SITE_LIVE=false
SITE_URL=https://eldenap.in

# ---- Supabase (Project Settings → API / Database) -------------------------
# Browser-safe values used only for admin sign-in:
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Google OAuth client ID (Google Cloud → Credentials) for the "Sign in with Google" button on /account.
# Public, not a secret. Without it, sign-in falls back to Supabase's redirect.
VITE_GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
# Server-only:
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Transaction pooler connection string (port 6543), from Connect → ORMs / Transaction pooler
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Only for older projects still on the legacy JWT secret (otherwise leave empty):
SUPABASE_JWT_SECRET=

# ---- Razorpay (Dashboard → Account & Settings → API Keys / Webhooks) ------
# Use rzp_test_… keys first; switch to rzp_live_… after a successful test order.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=a-long-random-string-you-also-enter-in-razorpay
# ---- Delhivery (shipping printed books: docs/DELHIVERY.md) ----------------
# API token from Delhivery One (Settings → API setup) or Delhivery's onboarding team. Secret.
# Without it the local dev server uses a Delhivery simulator.
DELHIVERY_API_TOKEN=
# production (track.delhivery.com, default) or staging (staging-express.delhivery.com, needs a staging token)
DELHIVERY_ENV=production
# Any long random string: the secret part of the address Delhivery pushes scans to
DELHIVERY_WEBHOOK_SECRET=

# ---- Email ------------------------------------------------------------------
# Sender of every email. With Google Workspace it must be SMTP_USER or one of its aliases.
# Customers' replies go to the support email set in the admin (Settings → Store).
MAIL_FROM=Elden Academic Press <noreply@eldenap.in>
# Our inboxes (comma-separated): they receive contact forms and enquiries, and a
# hidden copy (BCC) of every email sent to a customer.
MAIL_TO=hello@eldenap.in
# Google Workspace: the sending account and a 16-letter app password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_USER=noreply@eldenap.in
SMTP_PASS=
# Defaults suit Gmail / Google Workspace:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Alternative to SMTP: Resend (resend.com). Used only when SMTP_USER/SMTP_PASS are empty.
RESEND_API_KEY=

# ---- Meta (Facebook / Instagram ads) --------------------------------------
# Events Manager → your dataset: the ID under its name (public).
VITE_META_PIXEL_ID=
# Dataset → Settings → Conversions API → Generate access token (secret).
META_CAPI_TOKEN=
# Events Manager → Test events → the TEST… code, only while testing.
META_TEST_EVENT_CODE=
# Student accounts are sent to Meta only from this age (by date of birth); younger or no date of birth: nothing. Default 13.
META_MIN_AGE=13

# ---- Calls (Sarvam voice agents) -------------------------------------------
# A long random string; the provider's call-end webhook is https://<site>/api/calls/webhook/<this>.
CALLS_WEBHOOK_SECRET=
# Sarvam Voice Agents (apps.sarvam.ai): the workspace API key (Settings → API Key; secret), and the
# org and workspace ids from the dashboard address (…/orgs/<org>/workspaces/<workspace>/…).
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
# The two outgoing campaigns the site adds customers to. All five set = calls are placed.
SARVAM_CART_CAMPAIGN_ID=
SARVAM_FEEDBACK_CAMPAIGN_ID=

# ---- WhatsApp (Meta WhatsApp Cloud API, Elden Academic Press portfolio) ----
# A system user's permanent token with whatsapp_business_messaging (secret).
WHATSAPP_TOKEN=
# The sending number's "Phone number ID" (not the phone number).
WHATSAPP_PHONE_NUMBER_ID=
# The WhatsApp Business Account ID (for creating and checking the message templates).
WHATSAPP_BUSINESS_ACCOUNT_ID=
# The Meta app's App secret (App settings → Basic), to check webhook signatures (secret).
WHATSAPP_APP_SECRET=
# Any long random string; the same one goes in the app's webhook settings as "Verify token".
WHATSAPP_VERIFY_TOKEN=

# ---- Security -------------------------------------------------------------
# The first person to sign in with this email becomes the store owner.
ADMIN_OWNER_EMAIL=hello@eldenap.in
# Long random strings (e.g. `openssl rand -base64 48`):
ORDER_LINK_SECRET=
CRON_SECRET=
