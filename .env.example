# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables (Production), then redeploy.
# Never commit real values.

# ---- Website --------------------------------------------------------------
# true = full website and store; anything else = coming-soon page (admin always works at /admin)
VITE_SITE_LIVE=false
SITE_URL=https://eldenap.in

# ---- Supabase (Project Settings → API / Database) -------------------------
# Browser-safe values used only for admin sign-in:
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only:
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Transaction pooler connection string (port 6543), from Connect → ORMs / Transaction pooler
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Only for older projects still on the legacy JWT secret (otherwise leave empty):
SUPABASE_JWT_SECRET=

# ---- Razorpay (Dashboard → Account & Settings → API Keys / Webhooks) ------
# Use rzp_test_… keys first; switch to rzp_live_… after a successful test order.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=a-long-random-string-you-also-enter-in-razorpay

# ---- Email ------------------------------------------------------------------
# Sender of every email. With Google Workspace it must be SMTP_USER or one of its aliases.
MAIL_FROM=Elden Academic Press <hello@eldenap.in>
# Inbox for contact forms and enquiries (comma-separated for several).
MAIL_TO=hello@eldenap.in
# Google Workspace: the sending account and a 16-letter app password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_USER=hello@eldenap.in
SMTP_PASS=
# Defaults suit Gmail / Google Workspace:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Alternative to SMTP: Resend (resend.com). Used only when SMTP_USER/SMTP_PASS are empty.
RESEND_API_KEY=

# ---- Security -------------------------------------------------------------
# The first person to sign in with this email becomes the store owner.
ADMIN_OWNER_EMAIL=hello@eldenap.in
# Long random strings (e.g. `openssl rand -base64 48`):
ORDER_LINK_SECRET=
CRON_SECRET=
